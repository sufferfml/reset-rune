{
  "name": "reset-rune",
  "version": "0.1.1",
  "description": "Automatically use Reset Runes (spare Codex resets) before they expire.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sufferfml/reset-rune.git"
  },
  "type": "module",
  "bin": {
    "reset-rune": "distribution/npm/cli.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"

    "distribution/npm/cli.cjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js test/reference/codex/*.test.js",
    "desktop": "swift run --package-path native BottledResetRuneMenu",
    "build:mac": "node scripts/package-native.mjs",
    "test:native": "swift test --package-path native",
    "pack:native": "node scripts/package-native.mjs"
  },
  "private": true
}
